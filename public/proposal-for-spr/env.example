import { useState, useEffect } from 'react';
import { Menu, X } from 'lucide-react';
import { useLanguage } from '../LanguageContext';

export function Navbar() {
  const [isScrolled, setIsScrolled] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const { language, setLanguage, t } = useLanguage();

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 20);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const navLinks = [
    { name: t('Context', 'Contexte'), href: '#context' },
    { name: t('Evolution', 'Évolution'), href: '#evolution' },
    { name: t('Opportunity', 'Opportunité'), href: '#opportunity' },
    { name: t('Approach', 'Approche'), href: '#roadmap' },
    { name: t('About me', 'À propos de moi'), href: '#about' },
    { name: t('FAQ', 'questions'), href: '#faq' },
  ];

  return (
    <header
      className={`fixed top-0 inset-x-0 z-50 transition-all duration-300 ${
        isScrolled ? 'bg-white/90 backdrop-blur-md shadow-sm py-4' : 'bg-transparent py-6'
      }`}
    >
      <div className="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <a href="#" className="font-sans font-bold text-xl tracking-tight text-charcoal">
            DR.
          </a>
        </div>

        {/* Desktop Nav */}
        <nav className="hidden md:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              key={link.name as string}
              href={link.href}
              className={`text-sm tracking-wide lowercase ${
                isScrolled ? 'text-gray-600 hover:text-charcoal' : 'text-gray-500 hover:text-charcoal'
              } transition-colors`}
            >
              {link.name}
            </a>
          ))}
          <div className="flex items-center gap-2 ml-4 border-l border-gray-300 pl-4">
            <button 
              onClick={() => setLanguage('en')}
              className={`text-xs uppercase tracking-wider ${language === 'en' ? 'text-charcoal font-bold' : 'text-gray-400 hover:text-gray-600'}`}
            >
              EN
            </button>
            <span className="text-gray-300">/</span>
            <button 
              onClick={() => setLanguage('fr')}
              className={`text-xs uppercase tracking-wider ${language === 'fr' ? 'text-charcoal font-bold' : 'text-gray-400 hover:text-gray-600'}`}
            >
              FR
            </button>
          </div>
        </nav>

        {/* Mobile menu button */}
        <div className="flex items-center gap-4 md:hidden">
          <div className="flex items-center gap-2 border-r border-gray-300 pr-4">
            <button 
              onClick={() => setLanguage('en')}
              className={`text-xs uppercase tracking-wider ${language === 'en' ? 'text-charcoal font-bold' : 'text-gray-400 hover:text-gray-600'}`}
            >
              EN
            </button>
            <span className="text-gray-300">/</span>
            <button 
              onClick={() => setLanguage('fr')}
              className={`text-xs uppercase tracking-wider ${language === 'fr' ? 'text-charcoal font-bold' : 'text-gray-400 hover:text-gray-600'}`}
            >
              FR
            </button>
          </div>
          <button
            className="text-charcoal"
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
          >
            {mobileMenuOpen ? <X size={24} /> : <Menu size={24} />}
          </button>
        </div>
      </div>

      {/* Mobile Nav */}
      {mobileMenuOpen && (
        <div className="md:hidden absolute top-full left-0 right-0 bg-white border-b border-gray-100 shadow-sm px-6 py-4 flex flex-col gap-4">
          {navLinks.map((link) => (
            <a
              key={link.name as string}
              href={link.href}
              className="text-lg tracking-wide lowercase text-gray-600 py-2 border-b border-gray-50 last:border-0"
              onClick={() => setMobileMenuOpen(false)}
            >
              {link.name}
            </a>
          ))}
        </div>
      )}
    </header>
  );
}
